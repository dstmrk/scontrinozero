{
  "name": "scontrinozero",
  "version": "1.6.0",
  "packageManager": "npm@11.12.1",
  "engines": {
    "node": ">=22.0.0"
  },
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && npm run build:sw",
    "build:sw": "serwist build serwist.config.mjs && node scripts/check-service-worker.mjs",
    "start": "next start",
    "lint": "eslint",
    "type-check": "tsc --noEmit && tsc -p tsconfig.sw.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:push": "dotenv -e .env.local -- drizzle-kit push",
    "db:migrate": "dotenv -e .env.local -- drizzle-kit migrate",
    "db:studio": "dotenv -e .env.local -- drizzle-kit studio",
    "migrations:check": "node scripts/check-migrations.mjs",
    "arch:check": "node scripts/check-architecture-docs.mjs",
    "seo:indexnow": "tsx scripts/indexnow-submit.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.5.7",
    "@marsidev/react-turnstile": "^1.5.4",
    "@point-of-sale/receipt-printer-encoder": "^3.0.3",
    "@point-of-sale/webbluetooth-receipt-printer": "^2.0.0",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.1.0",
    "@sentry/nextjs": "^10.68.0",
    "@serwist/next": "^9.5.12",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.110.9",
    "@tanstack/react-query": "^5.101.4",
    "@types/pdfkit": "^0.17.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "0.45.2",
    "lucide-react": "^1.27.0",
    "next-themes": "^0.4.6",
    "pdfkit": "^0.19.1",
    "pino": "^10.3.1",
    "postgres": "^3.4.9",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-day-picker": "^10.0.0",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.83.0",
    "react-joyride": "^3.2.0",
    "react-qr-code": "^2.2.0",
    "recharts": "^3.10.1",
    "resend": "^6.18.1",
    "serwist": "^9.5.7",
    "sonner": "^2.0.7",
    "stripe": "^22.4.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@serwist/cli": "^9.5.12",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-bluetooth": "^0.0.21",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10",
    "eslint-config-next": "^16.2.12",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.2.0",
    "next": "^16.2.12",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "shadcn": "^4.15.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.3",
    "vitest-sonar-reporter": "^3.0.0"
  },
  "overrides": {
    "typescript-eslint": "^8.58.1",
    "hono": "^4.12.34",
    "@hono/node-server": "^2.0.5",
    "undici": "^7.29.0",
    "path-to-regexp@>=8.0.0 <8.4.0": "^8.4.0",
    "vite": "^8.0.5",
    "yaml": ">=2.8.3",
    "js-yaml": "^4.3.1",
    "sharp": "^0.35.0",
    "picomatch": "4.0.4",
    "express-rate-limit": "^8.5.1",
    "ip-address": "^10.4.0",
    "fast-uri": "^3.1.5",
    "qs": "^6.15.2",
    "postcss": "^8.5.18",
    "nanoid": "^3.3.17",
    "brace-expansion": "5.0.9",
    "micromatch": {
      "picomatch": "2.3.2"
    },
    "minimatch@^3.0.0": {
      "brace-expansion": "1.1.18"
    },
    "minimatch@^9.0.0": {
      "brace-expansion": "2.0.3"
    }
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,mjs}": [
      "prettier --write"
    ]
  }
}
